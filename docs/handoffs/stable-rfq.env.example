# ── Gimbal Stable RFQ — environment for the spUSD quoter service ──────────────
# The dapp builder runs the stable-leg quoter service with these values. It's the
# SAME service shape as the N-desk quoter (docs/handoffs/solo-rfq-quoter-spec.md) with
# the spUSD pricing deltas in docs/handoffs/stable-rfq-spec.md §8 (NAV fair, depletion
# skew, inventory-only sell). Pre-filled with the deployed Sepolia stable desk +
# launch defaults. Kyle fills the ONE secret marked [FILL — KYLE]. Do NOT commit the
# filled file (it holds a private key).

# ── connection ────────────────────────────────────────────────────────────────
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── quoter signing key  [FILL — KYLE] ──────────────────────────────────────────
# Generate a FRESH key, SEPARATE from the N desk's (blast-radius isolation):  cast wallet new
#   - paste the PRIVATE KEY below (this service signs spUSD quotes with it)
#   - send me the ADDRESS so the desk is told to trust it: set_quoter(<address>) on the stable desk
# Only signs quotes — never moves desk funds. Bounded on-chain by the NAV floor + caps,
# revocable via set_quoter/set_paused. Host secret store, never git.
QUOTER_PRIVATE_KEY=

# ── addresses (pre-filled — deployed, Blockscout-verified Sepolia STABLE desk) ──
FILLER_ADDRESS=0x520089CCFCB62cd79971afeBB3A3EA2E973E29cc
TRACKER_ADDRESS=0x80A229e1d85fd75511B889D0e7a2A8CA34f94FAE

# ── server ──────────────────────────────────────────────────────────────────────
PORT=8081
# frontend origin(s) allowed to call /quote (e.g. https://gimbal.finance). "*" for dev.
CORS_ORIGINS=*

# ── pricing / risk (launch defaults: quote WIDE, cap SMALL; tune later) ──────────
# fair = share_price() ÷ x  (NAV/share USD -> ETH). Floor: sell >= fair*(1+min_edge),
# buy <= fair*(1-min_edge). All spUSD amounts are 1e18-scaled UNITS (1e18 = 1 spUSD ≈ $1).
BASE_SPREAD_BPS=100                          # base spread (>= MIN_EDGE_BPS)
MIN_EDGE_BPS=100                             # floor in quotes (>= the desk's on-chain MIN_EDGE = 1%); also >= within-window oracle drift (F-DRIFT)
SKEW_K=2                                     # depletion-axis skew: widen SELL as inventory empties
MAX_FILL_SPUSD=100000000000000000000         # 100 spUSD max per fill (matches the desk's on-chain max_fill)
MAX_INVENTORY_SPUSD=3000000000000000000000   # 3000 spUSD net-long cap (matches on-chain max_net_spusd UNITS; keep < ~3 ETH until two-sided flow)
TARGET_INVENTORY_SPUSD=2000000000000000000000 # target book the skew pulls toward
SELL_RESERVE_SPUSD=0                          # spUSD the sell side won't dip below (the no-mint-to-sell floor; mirror on-chain min_spusd_float)
TTL_SECONDS=45                               # quote lifetime — keep short
DESK_MAX_STALENESS=600                        # quoter's own freshness bound (<= the desk's on-chain DESK_MAX_STALENESS)
POOL_NAV_TOLERANCE_BPS=50                     # gate disposing redeemed P into the spUSD/WETH pool; HOLD when the pool is this far off NAV

# ── after filling: prove the wiring ──────────────────────────────────────────────
# Once QUOTER_PRIVATE_KEY is set on-chain (set_quoter) and this is filled, verify the
# EIP-712 digest matches the live contract (the 7-field, series-less Quote) AND that the
# stable desk's DOMAIN_SEPARATOR != the N desk's — see stable-rfq-spec.md §6 (F-DOMAIN).
