# ── Gimbal Solo RFQ — environment for the quoter service ──────────────────────
# The dapp builder runs the quoter service (spec: docs/handoffs/solo-rfq-quoter-spec.md) with
# these values. Pre-filled with the deployed Sepolia spUSD desk + launch defaults.
# Kyle fills the ONE secret marked [FILL — KYLE]; everything else can stay as-is for
# the testnet launch. Do NOT commit the filled file (it holds a private key).

# ── connection ────────────────────────────────────────────────────────────────
# Sepolia RPC. The public one is fine for testing; use a paid/archive endpoint for uptime.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── quoter signing key  [FILL — KYLE] ──────────────────────────────────────────
# Generate a FRESH key (don't reuse a funded wallet):   cast wallet new
#   - paste the PRIVATE KEY below (this service signs quotes with it)
#   - send me the ADDRESS so the desk is told to trust it: set_quoter(<address>)
# This key ONLY signs quotes — it never holds or moves desk funds. Its blast radius is
# bounded on-chain by the directional edge floor + caps, and killable via set_quoter /
# set_paused. Still a hot secret: put it in the host's secret store, never in git.
QUOTER_PRIVATE_KEY=

# ── addresses (pre-filled — deployed, Blockscout-verified Sepolia spUSD desk) ───
FILLER_ADDRESS=0x48c93eD52507DEe37d79eA37Df9ed7fAF739C8F1
TRACKER_ADDRESS=0x80A229e1d85fd75511B889D0e7a2A8CA34f94FAE

# ── server ──────────────────────────────────────────────────────────────────────
PORT=8080
# frontend origin(s) allowed to call /quote (e.g. https://gimbal.finance). "*" for dev.
CORS_ORIGINS=*

# ── pricing / risk (launch defaults: quote WIDE, cap SMALL; tune later) ──────────
BASE_SPREAD_BPS=150                       # base spread the desk takes (>= MIN_EDGE_BPS)
MIN_EDGE_BPS=100                          # floor written into every quote (>= the desk's on-chain MIN_EDGE = 1%)
SKEW_K=2                                  # inventory-skew strength
MAX_FILL_N=100000000000000000            # 0.1 N max per fill (matches the desk's on-chain max_fill)
INVENTORY_CAP_N=3000000000000000000      # net-long-N at which the buy side goes one-sided
TTL_SECONDS=60                            # quote lifetime — keep short
PRE_MATURITY_BUFFER_SECONDS=172800        # 2d; mirror the desk's PRE_MATURITY_BUFFER

# ── after filling: prove the wiring ──────────────────────────────────────────────
# Once QUOTER_PRIVATE_KEY is set on-chain (set_quoter) and this is filled:
#   npm run verify-digest      # asserts the EIP-712 digest matches the live contract
